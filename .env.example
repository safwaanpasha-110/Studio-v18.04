# Environment Variables Configuration
# Copy this file to .env.local for local development
# Copy this file to .env.production for production deployment

# ===========================================
# FRS API Configuration (Required)
# ===========================================
# Base URL for the Facial Recognition System API
# Local: http://127.0.0.1:8000
# Azure: http://172.203.130.108
NEXT_PUBLIC_FRS_BASE_URL=http://127.0.0.1:8000

# Authentication token for FRS API
NEXT_PUBLIC_FRS_TOKEN=your_frs_token_here

# ===========================================
# AI Image Enhancement API (Optional)
# ===========================================
# DeepAI API Key for AI image enhancement
# Get from: https://deepai.org/
NEXT_PUBLIC_DEEPAI_API_KEY=your_deepai_api_key_here
